# ============================================================================
# Core Banking Demo — Environment Variables
# ============================================================================
# Copy this file to .env and adjust values as needed:
#   cp .env.example .env
#
# WARNING: The defaults below are for LOCAL DEVELOPMENT ONLY.
#          Never use these values in a production environment.
# ============================================================================

# === Identity Database (API Gateway) ===
IDENTITY_DB_USER=admin
IDENTITY_DB_PASSWORD=changemeinprod!
IDENTITY_DB_NAME=identity_db

# === Keycloak Database ===
KEYCLOAK_DB_USER=user
KEYCLOAK_DB_PASSWORD=changemeinprod!
KEYCLOAK_DB_NAME=keycloak

# === Keycloak Admin Console ===
KEYCLOAK_ADMIN=admin
KEYCLOAK_ADMIN_PASSWORD=admin

# === Keycloak OIDC Client Secret ===
# Must match the secret configured in keycloak-config/realm-export.json
KEYCLOAK_CLIENT_SECRET=CHANGEMEINPROD

# === Keycloak SMTP (Email Verification) ===
# Defaults point to the local MailHog container.
# Replace with a real SMTP provider for production.
KEYCLOAK_SMTP_HOST=mailhog
KEYCLOAK_SMTP_PORT=1025
KEYCLOAK_SMTP_FROM=no-reply@corebanking.local
KEYCLOAK_SMTP_REPLY_TO=no-reply@corebanking.local
KEYCLOAK_SMTP_USER=
KEYCLOAK_SMTP_PASSWORD=
KEYCLOAK_SMTP_AUTH=false
KEYCLOAK_SMTP_STARTTLS=false
KEYCLOAK_SMTP_SSL=false
